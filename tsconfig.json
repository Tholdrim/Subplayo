{
  "compilerOptions": {
    "rootDir": "src",
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "bundler",
    "lib": [ "es2020" ],
    "types": [ "google-apps-script" ],
    "strict": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
