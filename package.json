{
  "name": "subplayo",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "npm run clean && rollup -c rollup.config.mjs && shx cp src/appsscript.json dist/appsscript.json",
    "clean": "shx rm -rf dist",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "tsc -p test/tsconfig.json && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.6",
    "@types/google-apps-script": "~2.0.15",
    "rollup": "~4.68.2",
    "rollup-plugin-typescript2": "~0.37.0",
    "shx": "~0.4.0",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
